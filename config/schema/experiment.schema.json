{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalEvolve experiment configuration",
  "type": "object",
  "required": ["design", "baseline_metrics", "target_metrics", "evaluator", "planner", "promotion"],
  "properties": {
    "design": {"type": "string", "minLength": 1},
    "state_root": {"type": "string"},
    "source_root": {"type": ["string", "null"], "description": "Optional OpenROAD source root. When omitted for contest_openroad, uses artifact_evaluation/lineage/openroad_power/p0/source or GOALEVOLVE_OPENROAD_SEED."},
    "build_seed_root": {"type": "string"},
    "benchmark_root": {"type": "string"},
    "campaign_ready": {"type": "boolean"},
    "baseline_metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "target_metrics": {"type": "object", "additionalProperties": {"type": "number"}},
    "planner": {"enum": ["diverse_planner", "round_robin"]},
    "evaluator": {"enum": ["contest_openroad", "mock"]},
    "student_editor": {"enum": ["codex_student", "noop_student"]},
    "teacher": {"enum": ["codex_teacher", "heuristic_teacher"]},
    "promotion": {"enum": ["strict_evidence", "power_first_promotion"]},
    "max_campaign_rounds": {"type": ["integer", "null"]},
    "epd_max_reinforcement_attempts": {"type": "integer", "minimum": 0, "default": 2, "description": "Maximum Enhancer attempts for one promising EPD idea."},
    "repository_graph_enabled": {"type": "boolean", "default": true, "description": "Enable P0-rooted tree-sitter source graphs for Teacher localization and AST anchor validation."}
  }
}
